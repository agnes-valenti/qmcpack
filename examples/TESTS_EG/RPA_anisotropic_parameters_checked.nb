                    SuperscriptBox[
                    RowBox[{"Sin", "[", "phi", "]"}], "2"], 
                    SqrtBox["Eta"]]}]]}]}], ")"}], "2"]}]], "]"}], 
          RowBox[{"y", " ", 
           SqrtBox[
            RowBox[{
             RowBox[{
              SqrtBox["Eta"], " ", 
              SuperscriptBox[
