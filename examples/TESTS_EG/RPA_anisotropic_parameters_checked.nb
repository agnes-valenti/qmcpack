Cell[TextData[StyleBox["Exchange energy - need factor from phi integration \
(factor 2 after for 8 vs 4 - need to check!!)\n",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Text",
 CellChangeTimes->{
  3.864720735973168*^9},ExpressionUUID->"e681e01c-cc8b-4dd9-a0e9-\
426282ae9b22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"phiintegration", "[", 
   RowBox[{"phi_", ",", "eta_"}], "]"}], "=", 
  RowBox[{"1", "/", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"eta", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], ")"}]}], "*", 
      RowBox[{
       RowBox[{"Cos", "[", "phi", "]"}], "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{"eta", "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}], "*", 
      RowBox[{
       RowBox[{"Sin", "[", "phi", "]"}], "^", "2"}]}]}], "]"}]}]}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"48806521-1022-47a6-bfea-36e95c67904f"],

Cell[BoxData[
 FractionBox["1", 
  SqrtBox[
   RowBox[{
    FractionBox[
     SuperscriptBox[
      RowBox[{"Cos", "[", "phi", "]"}], "2"], 
     SqrtBox["eta"]], "+", 
    RowBox[{
     SqrtBox["eta"], " ", 
     SuperscriptBox[
      RowBox[{"Sin", "[", "phi", "]"}], "2"]}]}]]]], "Output",
 CellChangeTimes->{3.864720752759082*^9, 3.864869965777726*^9, 
  3.864870160536396*^9, 3.868707748580123*^9, 3.868802535109181*^9, 
