Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"yu", "[", 
   RowBox[{"y_", ",", "phi_", ",", "Eta_"}], "]"}], "=", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", "Eta", "]"}], "*", 
      RowBox[{
       RowBox[{"Cos", "[", "phi", "]"}], "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", "Eta", "]"}]}], "*", 
      RowBox[{
       RowBox[{"Sin", "[", "phi", "]"}], "^", "2"}]}]}], "]"}], "*", 
   "y"}]}]], "Input",
