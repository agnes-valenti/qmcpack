Cell[TextData[StyleBox["Ground state (RPA) energy for valley-polarization, \
spin-polarization and the symmetric state",
 FontSize->16,
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Text",
 CellChangeTimes->{{3.864377884118533*^9, 
  3.86437791273763*^9}},ExpressionUUID->"ed013977-cafd-4de5-bd1b-\
afbbcdb3d2ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"EkinVP", "[", "rs", "]"}], "+", 
      RowBox[{"ExVP", "[", 
       RowBox[{"rs", ",", "EtaValue"}], "]"}], "+", 
      RowBox[{
       RowBox[{"1.0", "/", "num"}], "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"2", "*", "Pi", "*", 
            RowBox[{"encorVP", "[", 
             RowBox[{"y", ",", 
              RowBox[{"2", "*", 
               RowBox[{"Pi", "/", "num"}], "*", "i"}], ",", "nu", ",", " ", 
              "rs", ",", "EtaValue"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", "0.0001", ",", "100"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"nu", ",", "0.0001", ",", "100"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "num"}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"EkinSP", "[", "rs", "]"}], "+", 
      RowBox[{"ExSP", "[", 
       RowBox[{"rs", ",", "EtaValue"}], "]"}], "+", 
      RowBox[{
       RowBox[{"1.0", "/", "num"}], "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"2", "*", "Pi", "*", 
            RowBox[{"encorSP", "[", 
             RowBox[{"y", ",", 
              RowBox[{"2", "*", 
               RowBox[{"Pi", "/", "num"}], "*", "i"}], ",", "nu", ",", " ", 
              "rs", ",", "EtaValue"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", "0.0001", ",", "100"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"nu", ",", "0.0001", ",", "100"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "num"}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"Ekinsym", "[", "rs", "]"}], "+", 
      RowBox[{"Exsym", "[", 
       RowBox[{"rs", ",", "EtaValue"}], "]"}], "+", 
      RowBox[{
       RowBox[{"1.0", "/", "num"}], "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"2", "*", "Pi", "*", 
            RowBox[{"encorsym", "[", 
             RowBox[{"y", ",", 
              RowBox[{"2", "*", 
               RowBox[{"Pi", "/", "num"}], "*", "i"}], ",", "nu", ",", " ", 
              "rs", ",", "EtaValue"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", "0.0001", ",", "100"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"nu", ",", "0.0001", ",", "100"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "num"}], "}"}]}], "]"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"rs", ",", "1", ",", "20"}], "}"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<r_s\>\"", ",", "\"\<Ground state energy E_RPA\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotLabels", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<VP\>\"", ",", "\"\<SP\>\"", ",", "\"\<sym\>\""}], "}"}]}]}],
   "]"}]], "Input",
 CellChangeTimes->{{3.863509059071828*^9, 3.863509123912806*^9}, {
  3.8643755414681883`*^9, 3.864375593438146*^9}, {3.8643768482535057`*^9, 
