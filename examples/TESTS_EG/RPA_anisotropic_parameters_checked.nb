Cell[TextData[StyleBox["Spin-polarized: Integral over encorSP gives \
correlation energy",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Text",
 CellChangeTimes->{{3.864364354749531*^9, 
  3.864364389452963*^9}},ExpressionUUID->"36f5495d-c6f2-4a8c-82d9-\
d624856d7e40"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"encorSP", "[", 
   RowBox[{"y_", ",", "phi_", ",", "nu_", ",", "rs_", ",", "Eta_"}], "]"}], 
  "=", 
  RowBox[{
   RowBox[{"4", "/", 
    RowBox[{"(", 
     RowBox[{"4", "*", 
      RowBox[{"Pi", "^", "2"}], "*", 
      RowBox[{"rs", "^", "2"}]}], ")"}]}], "*", 
   RowBox[{"y", "^", "2"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"f2SP", "[", 
      RowBox[{"y", ",", "phi", ",", "nu", ",", "rs", ",", "Eta"}], "]"}], "+", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", 
       RowBox[{"f2SP", "[", 
        RowBox[{"y", ",", "phi", ",", "nu", ",", "rs", ",", "Eta"}], "]"}]}], 
      "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.862914041995903*^9, 3.862914161694271*^9}, {
  3.862914317778963*^9, 3.8629143181895247`*^9}, {3.862914373142549*^9, 
