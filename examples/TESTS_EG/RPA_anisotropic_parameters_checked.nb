          RowBox[{"{", 
           RowBox[{"nu", ",", "0.0001", ",", "100"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "num"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"1.0", "/", "num"}], "*", 
