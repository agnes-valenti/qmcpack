 FractionBox[
  RowBox[{
   SqrtBox["2"], " ", "rs", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     FractionBox[
      RowBox[{"Re", "[", 
       SqrtBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", 
            RowBox[{
             FractionBox["1", "2"], " ", "y", " ", 
             SqrtBox[
              RowBox[{
               RowBox[{
                SqrtBox["Eta"], " ", 
                SuperscriptBox[
                 RowBox[{"Cos", "[", "phi", "]"}], "2"]}], "+", 
               FractionBox[
                SuperscriptBox[
                 RowBox[{"Sin", "[", "phi", "]"}], "2"], 
                SqrtBox["Eta"]]}]]}]}], ")"}], "2"]}]], "]"}], 
      RowBox[{"y", " ", 
       SqrtBox[
        RowBox[{
         RowBox[{
          SqrtBox["Eta"], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "phi", "]"}], "2"]}], "+", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"Sin", "[", "phi", "]"}], "2"], 
          SqrtBox["Eta"]]}]]}]], "+", 
     FractionBox[
      RowBox[{"Re", "[", 
       SqrtBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", 
            RowBox[{
             FractionBox["1", "2"], " ", "y", " ", 
             SqrtBox[
              RowBox[{
               FractionBox[
                SuperscriptBox[
                 RowBox[{"Cos", "[", "phi", "]"}], "2"], 
                SqrtBox["Eta"]], "+", 
               RowBox[{
                SqrtBox["Eta"], " ", 
                SuperscriptBox[
                 RowBox[{"Sin", "[", "phi", "]"}], "2"]}]}]]}]}], ")"}], 
