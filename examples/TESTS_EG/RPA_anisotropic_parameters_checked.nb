Cell[TextData[StyleBox["Valley-polarized: Vq*chi, rescaled and in polar \
coordinates",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Text",
 CellChangeTimes->{{3.864364407652234*^9, 3.864364413267878*^9}, {
  3.864371937758892*^9, 
  3.86437197862463*^9}},ExpressionUUID->"5e6a9636-857a-4093-836a-\
70d12c8c4c54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"f2VP", "[", 
   RowBox[{"y_", ",", "phi_", ",", "nu_", ",", "rs_", ",", "Eta_"}], "]"}], 
  "=", 
  RowBox[{
   RowBox[{"Sqrt", "[", "2", "]"}], "*", "rs", "*", 
   RowBox[{"1", "/", "y"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{
      RowBox[{"2", "/", 
       RowBox[{"yu", "[", 
        RowBox[{"y", ",", "phi", ",", "Eta"}], "]"}]}], "*", 
      RowBox[{"Re", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"yu", "[", 
              RowBox[{"y", ",", "phi", ",", "Eta"}], "]"}], "/", "2"}], "+", 
            RowBox[{"nu", "*", "I"}]}], ")"}], "^", "2"}], "-", "1"}], "]"}], 
       "]"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.8629149567378883`*^9, 3.8629149705677443`*^9}, {
  3.864377334948367*^9, 3.864377349920923*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"e97de9a7-695a-4281-a406-19d1c6bb84dc"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SqrtBox["2"], " ", "rs", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     FractionBox[
      RowBox[{"2", " ", 
       RowBox[{"Re", "[", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", 
             RowBox[{
              FractionBox["1", "2"], " ", "y", " ", 
              SqrtBox[
               RowBox[{
                RowBox[{
                 SqrtBox["Eta"], " ", 
                 SuperscriptBox[
                  RowBox[{"Cos", "[", "phi", "]"}], "2"]}], "+", 
                FractionBox[
                 SuperscriptBox[
                  RowBox[{"Sin", "[", "phi", "]"}], "2"], 
                 SqrtBox["Eta"]]}]]}]}], ")"}], "2"]}]], "]"}]}], 
      RowBox[{"y", " ", 
       SqrtBox[
        RowBox[{
         RowBox[{
          SqrtBox["Eta"], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "phi", "]"}], "2"]}], "+", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"Sin", "[", "phi", "]"}], "2"], 
          SqrtBox["Eta"]]}]]}]]}], ")"}]}], "y"]], "Output",
 CellChangeTimes->{
  3.862914972846294*^9, 3.8629150603889923`*^9, {3.862915470565995*^9, 
   3.8629154809555893`*^9}, 3.862915517760687*^9, 3.8629157604091883`*^9, 
   3.862917724667632*^9, 3.862919228460623*^9, 3.862932642051045*^9, 
   3.86350801014281*^9, 3.863508884277792*^9, 3.863510179916068*^9, 
   3.864375623463849*^9, 3.8643774105517883`*^9, 3.864387143868157*^9, 
   3.8643879718773108`*^9, 3.86438848404502*^9, 3.864398472356267*^9, 
   3.8647125315283813`*^9, 3.8648698783455772`*^9, 3.864870104779945*^9, 
   3.868707727564376*^9, 3.869215827926882*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"0b53a624-7d34-47a5-a99c-08d99f2a3b18"]
}, Open  ]],

Cell[TextData[StyleBox["Valley-polarized: Integral over encorVP gives \
correlation energy",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Text",
 CellChangeTimes->{{3.8643720469564466`*^9, 
  3.864372068672785*^9}},ExpressionUUID->"a09e1c18-e162-41a4-8358-\
76dc3cc0e7e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"encorVP", "[", 
   RowBox[{"y_", ",", "phi_", ",", "nu_", ",", "rs_", ",", "Eta_"}], "]"}], 
  "=", 
  RowBox[{
   RowBox[{"4", "/", 
    RowBox[{"(", 
     RowBox[{"4", "*", 
      RowBox[{"Pi", "^", "2"}], "*", 
      RowBox[{"rs", "^", "2"}]}], ")"}]}], "*", 
   RowBox[{"y", "^", "2"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"f2VP", "[", 
      RowBox[{"y", ",", "phi", ",", "nu", ",", "rs", ",", "Eta"}], "]"}], "+", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", 
       RowBox[{"f2VP", "[", 
        RowBox[{"y", ",", "phi", ",", "nu", ",", "rs", ",", "Eta"}], "]"}]}], 
      "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.862914984095446*^9, 3.862914991317665*^9}, {
  3.862916044021364*^9, 3.862916066035969*^9}, {3.8635080180511093`*^9, 
  3.8635080513030443`*^9}, {3.8643773631076717`*^9, 3.864377374116274*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"97ff5c95-b055-41ca-bc55-07b7251a64ea"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["y", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", 
       FractionBox[
        RowBox[{
         SqrtBox["2"], " ", "rs", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           FractionBox[
            RowBox[{"2", " ", 
             RowBox[{"Re", "[", 
              SqrtBox[
               RowBox[{
                RowBox[{"-", "1"}], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", 
                   RowBox[{
                    FractionBox["1", "2"], " ", "y", " ", 
                    SqrtBox[
                    RowBox[{
                    RowBox[{
                    SqrtBox["Eta"], " ", 
                    SuperscriptBox[
                    RowBox[{"Cos", "[", "phi", "]"}], "2"]}], "+", 
                    FractionBox[
                    SuperscriptBox[
                    RowBox[{"Sin", "[", "phi", "]"}], "2"], 
                    SqrtBox["Eta"]]}]]}]}], ")"}], "2"]}]], "]"}]}], 
            RowBox[{"y", " ", 
             SqrtBox[
              RowBox[{
               RowBox[{
                SqrtBox["Eta"], " ", 
                SuperscriptBox[
                 RowBox[{"Cos", "[", "phi", "]"}], "2"]}], "+", 
               FractionBox[
                SuperscriptBox[
                 RowBox[{"Sin", "[", "phi", "]"}], "2"], 
                SqrtBox["Eta"]]}]]}]]}], ")"}]}], "y"]}], "]"}], "+", 
     FractionBox[
      RowBox[{
       SqrtBox["2"], " ", "rs", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         FractionBox[
          RowBox[{"2", " ", 
           RowBox[{"Re", "[", 
            SqrtBox[
             RowBox[{
              RowBox[{"-", "1"}], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"\[ImaginaryI]", " ", "nu"}], "+", 
                 RowBox[{
                  FractionBox["1", "2"], " ", "y", " ", 
                  SqrtBox[
                   RowBox[{
                    RowBox[{
                    SqrtBox["Eta"], " ", 
                    SuperscriptBox[
                    RowBox[{"Cos", "[", "phi", "]"}], "2"]}], "+", 
                    FractionBox[
                    SuperscriptBox[
                    RowBox[{"Sin", "[", "phi", "]"}], "2"], 
                    SqrtBox["Eta"]]}]]}]}], ")"}], "2"]}]], "]"}]}], 
          RowBox[{"y", " ", 
           SqrtBox[
            RowBox[{
             RowBox[{
              SqrtBox["Eta"], " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "phi", "]"}], "2"]}], "+", 
             FractionBox[
              SuperscriptBox[
               RowBox[{"Sin", "[", "phi", "]"}], "2"], 
              SqrtBox["Eta"]]}]]}]]}], ")"}]}], "y"]}], ")"}]}], 
  RowBox[{
   SuperscriptBox["\[Pi]", "2"], " ", 
   SuperscriptBox["rs", "2"]}]]], "Output",
 CellChangeTimes->{
  3.862916937071076*^9, {3.862917022906798*^9, 3.8629170422296867`*^9}, 
   3.8629171455353937`*^9, {3.862917728032712*^9, 3.862917738497793*^9}, 
