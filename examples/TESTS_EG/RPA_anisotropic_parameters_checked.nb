 RowBox[{
  RowBox[{"newexc", "[", 
   RowBox[{"q_", ",", "kF_"}], "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "1"}], "/", "2"}], "*", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{
      RowBox[{"2", "/", "Pi"}], "*", 
