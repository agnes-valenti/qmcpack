Cell[BoxData[
 RowBox[{
  RowBox[{"encorSVP", "[", 
   RowBox[{"y_", ",", "phi_", ",", "nu_", ",", "rs_", ",", "Eta_"}], "]"}], 
  "=", 
  RowBox[{"4", "*", 
   RowBox[{"4", "/", 
    RowBox[{"(", 
     RowBox[{"4", "*", 
      RowBox[{"Pi", "^", "2"}], "*", 
      RowBox[{"rs", "^", "2"}]}], ")"}]}], "*", 
   RowBox[{"y", "^", "2"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"0.5", "*", 
      RowBox[{"f2VP", "[", 
       RowBox[{"y", ",", "phi", ",", "nu", ",", 
        RowBox[{"rs", "/", 
         RowBox[{"Sqrt", "[", "2", "]"}]}], ",", "Eta"}], "]"}]}], "+", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", 
       RowBox[{"0.5", "*", 
        RowBox[{"f2VP", "[", 
         RowBox[{"y", ",", "phi", ",", "nu", ",", 
          RowBox[{"rs", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ",", "Eta"}], "]"}]}]}], 
      "]"}]}], ")"}]}]}]], "Input",
