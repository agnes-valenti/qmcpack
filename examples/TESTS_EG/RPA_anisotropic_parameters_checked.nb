Cell[TextData[StyleBox["Spin-polarized: Vq*chi, rescaled and in polar \
coordinates",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Text",
 CellChangeTimes->{{3.8643642039098454`*^9, 3.864364220485673*^9}, {
  3.864364314812109*^9, 3.8643643473047047`*^9}, {3.864375614211225*^9, 
  3.8643756158754473`*^9}},ExpressionUUID->"92ff3268-6aac-41d6-91fc-\
531654061255"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"f2SP", "[", 
   RowBox[{"y_", ",", "phi_", ",", "nu_", ",", "rs_", ",", "Eta_"}], "]"}], 
  "=", 
  RowBox[{
   RowBox[{"Sqrt", "[", "2", "]"}], "*", "rs", "*", 
   RowBox[{"1", "/", "y"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"yu", "[", 
        RowBox[{"y", ",", "phi", ",", "Eta"}], "]"}]}], "*", 
      RowBox[{"Re", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"yu", "[", 
              RowBox[{"y", ",", "phi", ",", "Eta"}], "]"}], "/", "2"}], "+", 
            RowBox[{"nu", "*", "I"}]}], ")"}], "^", "2"}], "-", "1"}], "]"}], 
       "]"}]}], "+", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"yd", "[", 
        RowBox[{"y", ",", "phi", ",", "Eta"}], "]"}]}], "*", 
      RowBox[{"Re", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"yd", "[", 
              RowBox[{"y", ",", "phi", ",", "Eta"}], "]"}], "/", "2"}], "+", 
            RowBox[{"nu", "*", "I"}]}], ")"}], "^", "2"}], "-", "1"}], "]"}], 
       "]"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.862913629277145*^9, 3.862913833549872*^9}, {
  3.862913910039125*^9, 3.86291391306135*^9}, {3.862914644977578*^9, 
  3.8629146520120907`*^9}, {3.862914793104773*^9, 3.8629148069646187`*^9}, {
  3.864377217995542*^9, 3.864377242540721*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"442109d7-fd06-49da-a046-621e3d9b035f"],

