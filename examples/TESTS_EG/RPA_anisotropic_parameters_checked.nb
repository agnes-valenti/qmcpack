Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"encorsym", "[", 
   RowBox[{"y_", ",", "phi_", ",", "nu_", ",", "rs_", ",", "Eta_"}], "]"}], 
  "=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"4", "*", 
      RowBox[{"Pi", "^", "2"}], "*", 
      RowBox[{"rs", "^", "2"}]}], ")"}]}], "*", 
   RowBox[{"y", "^", "2"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", "*", 
      RowBox[{"f2SP", "[", 
       RowBox[{"y", ",", "phi", ",", "nu", ",", 
        RowBox[{
         RowBox[{"Sqrt", "[", "2", "]"}], "*", "rs"}], ",", "Eta"}], "]"}]}], 
     "+", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", 
       RowBox[{"2", "*", 
        RowBox[{"f2SP", "[", 
         RowBox[{"y", ",", "phi", ",", "nu", ",", 
          RowBox[{
           RowBox[{"Sqrt", "[", "2", "]"}], "*", "rs"}], ",", "Eta"}], 
         "]"}]}]}], "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.863508183765416*^9, 3.863508191308464*^9}, {
