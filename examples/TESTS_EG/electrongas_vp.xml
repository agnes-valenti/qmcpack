<?xml version="1.0"?>
<simulation>
  <project id="EG" series="0"/>
  <random seed="491"/>
  <qmcsystem>
  <simulationcell>
    <parameter name="rs" pol="0" condition="14">6.5</parameter>
    <parameter name="bconds">p p p</parameter>
    <parameter name="LR_dim_cutoff">15</parameter>
  </simulationcell>
  </qmcsystem>
  <particleset name="e" random="yes">
