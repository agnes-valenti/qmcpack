  </wavefunction>
  <hamiltonian name="h0" target="e">
 <pairpot name="ElecElec" type="coulomb" source="e" target="e" physical="true"/>
  </hamiltonian>

    <loop max="180">
    <qmc method="linear" move="pbyp" checkpoint="-1" gpu="no">
    <parameter name="walkers">     8  </parameter>
    <parameter name="blocks">     2  </parameter>
      <parameter name="warmupsteps"> 20 </parameter>
      <parameter name="steps"> 40 </parameter>
      <parameter name="substeps"> 20 </parameter>
      <parameter name="timestep"> 20 </parameter>
      <parameter name="samples">  640 </parameter>
      <cost name="energy">                   1.0 </cost>
      <cost name="unreweightedvariance">     0.0 </cost>
      <cost name="reweightedvariance">       0.0 </cost>
      <parameter name="useDrift">  no </parameter>
      <parameter name="bigchange">10.0</parameter>
      <estimator name="LocalEnergy" hdf5="no"/>
      <parameter name="nonlocalpp"> no </parameter>
      <parameter name="MinMethod">quartic</parameter>
      <parameter name="minwalkers"> 1e-4 </parameter>
      <parameter name="exp0">-6</parameter>
      <parameter name="alloweddifference"> 1.0e-5 </parameter>
      <parameter name="stepsize">  0.04 </parameter>
      <parameter name="nstabilizers"> 1 </parameter>
    </qmc>
  </loop>

