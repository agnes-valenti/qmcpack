    <group name="dt" size="8">
      <parameter name="charge">-1</parameter>
      <parameter name="mass">1</parameter>
    </group-->
  </particleset>
  <wavefunction name="psi0" target="e">
   
<sposet_builder type="heg">
  <sposet name="spo-u" size="11" twist="0 0 0"/>
  <sposet name="spo-ut" size="11" twist="0 0 0"/>
  <!--sposet name="spo-ut" size="8" twist="0 0 0"/>
  <sposet name="spo-dt" size="8" twist="0 0 0"/-->
</sposet_builder>

