Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ExVPscreened", "[", 
   RowBox[{"z_", ",", "phi_", ",", "Eta_", ",", "rs_", ",", "d1_"}], "]"}], 
  "=", 
  RowBox[{
   RowBox[{"-", "2"}], "*", 
   RowBox[{
    RowBox[{"Sqrt", "[", "2", "]"}], "/", "rs"}], "*", 
   RowBox[{"1", "/", "eps"}], "*", 
   RowBox[{
    RowBox[{"Tanh", "[", 
     RowBox[{"2", "*", "z", "*", "d1", "*", "oneoveraB", "*", 
      RowBox[{
       RowBox[{"Sqrt", "[", "2", "]"}], "/", "rs"}], "*", 
      RowBox[{"qrev", "[", 
       RowBox[{"phi", ",", "Eta"}], "]"}]}], "]"}], "/", 
    RowBox[{"qrev", "[", 
     RowBox[{"phi", ",", "Eta"}], "]"}]}], "*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"2", "/", "Pi"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"ArcSin", "[", "z", "]"}], "+", 
         RowBox[{"z", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", "-", 
            RowBox[{"z", "^", "2"}]}], "]"}]}]}], ")"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "*", "Pi"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{3.869566967646504*^9},
 CellLabel->"In[33]:=",ExpressionUUID->"28cafe59-4213-4f84-8a2e-387982418028"],

