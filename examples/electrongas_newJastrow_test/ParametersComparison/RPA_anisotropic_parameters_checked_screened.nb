         RowBox[{"z", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"phi", ",", "0", ",", 
          RowBox[{"2", "*", "Pi"}]}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"EkinSP", "[", 
       RowBox[{"rsn", "[", "nit", "]"}], "]"}], "-", 
      RowBox[{"Ekinsym", "[", 
       RowBox[{"rsn", "[", "nit", "]"}], "]"}], "+", 
