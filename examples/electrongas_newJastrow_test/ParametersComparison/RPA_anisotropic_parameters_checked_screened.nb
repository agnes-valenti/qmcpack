Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Exsymscreened", "[", 
   RowBox[{"z_", ",", "phi_", ",", "Eta_", ",", "rs_", ",", "d1_"}], "]"}], 
  "=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], "/", "rs"}], "*", 
   RowBox[{"1", "/", "eps"}], "*", 
   RowBox[{
    RowBox[{"Tanh", "[", 
     RowBox[{"2", "*", "z", "*", "d1", "*", "oneoveraB", "*", 
      RowBox[{"1", "/", "rs"}], "*", 
      RowBox[{"qrev", "[", 
       RowBox[{"phi", ",", "Eta"}], "]"}]}], "]"}], "/", 
    RowBox[{"qrev", "[", 
     RowBox[{"phi", ",", "Eta"}], "]"}]}], "*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"2", "/", "Pi"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"ArcSin", "[", "z", "]"}], "+", 
         RowBox[{"z", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", "-", 
            RowBox[{"z", "^", "2"}]}], "]"}]}]}], ")"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "*", "Pi"}], ")"}]}]}]}]], "Input",
