Cell[BoxData[
 RowBox[{
  RowBox[{"phiintegration", "[", 
   RowBox[{"phi_", ",", "eta_"}], "]"}], "=", 
  RowBox[{"1", "/", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"eta", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], ")"}]}], "*", 
      RowBox[{
       RowBox[{"Cos", "[", "phi", "]"}], "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{"eta", "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}], "*", 
      RowBox[{
       RowBox[{"Sin", "[", "phi", "]"}], "^", "2"}]}]}], "]"}]}]}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"48806521-1022-47a6-bfea-36e95c67904f"],

