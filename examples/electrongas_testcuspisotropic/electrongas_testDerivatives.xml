<?xml version="1.0"?>
<simulation>
  <project id="EG" series="0"/>
  <random seed="494"/>
  <qmcsystem>
  <simulationcell>
    <parameter name="rs" pol="0" condition="14">6.5</parameter>
    <parameter name="bconds">p p p</parameter>
    <parameter name="LR_dim_cutoff">15</parameter>
  </simulationcell>
  </qmcsystem>
  <particleset name="e" random="yes">
    <group name="u" size="2">
      <parameter name="charge">-1</parameter>
      <parameter name="mass">1</parameter>
    </group>
    <group name="ut" size="2">
      <parameter name="charge">-1</parameter>
      <parameter name="mass">1</parameter>
    </group>
    <!--group name="ut" size="11">
      <parameter name="charge">-1</parameter>
      <parameter name="mass">1</parameter>
    </group-->
    <!--group name="dt" size="11">
      <parameter name="charge">-1</parameter>
      <parameter name="mass">1</parameter>
    </group-->
  </particleset>
  <wavefunction name="psi0" target="e">
   
<sposet_builder type="heg">
  <sposet name="spo-u" size="2" twist="0 0 0"/>
  <sposet name="spo-ut" size="2" twist="0 0 0"/>
</sposet_builder>

<determinantset>

 <backflow>
